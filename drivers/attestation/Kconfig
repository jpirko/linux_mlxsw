menuconfig ATTESTATION
	tristate "Attestation"
	depends on CTLV
	help
	  Provides a CTLV family for evidence, measurement registers,
	  device-security transitions, and an append-only measurement journal.

	  Providers register one instance for a physical or logical device and
	  translate the common operations to their native service.

	  If you are unsure, say N.

if ATTESTATION

config ATTESTATION_KUNIT_TEST
	tristate "Attestation core KUnit tests" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Checks provider contracts, generation and journal transactions,
	  kernel targets, lifecycle races, allocation failures and orderly
	  kexec serialization without a hardware provider.

	  The tests are a separate module named attestation-kunit.

	  If you are unsure, say N.

config ATTESTATION_SIM
	tristate "Simulated attestation provider"
	depends on DEBUG_FS
	select CRYPTO_SHA256
	select CRYPTO_SHA512
	help
	  Provides synthetic evidence, measurement registers and device-security
	  state for the attestation selftests. Fixtures are created through
	  debugfs or, when built in, with the early_fixture module parameter.

	  This provider offers no hardware security.

	  If you are unsure, say N.

config ATTESTATION_TDX
	tristate "TDX attestation provider"
	depends on TDX_GUEST_DRIVER
	help
	  Exposes TDREPORT, Quote, MRTD and RTMR operations through the common
	  attestation CTLV family. The native TDX misc, TSM-report and TSM-MR
	  interfaces remain available independently.

	  If you are unsure, say N.

endif # ATTESTATION
